{
  "name": "lyricue",
  "version": "0.2.1",
  "description": "A zero-dependency Web Component for syncing lyrics to music, featuring audio waveforms, keyboard controls, and precise timeline editing.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json",
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "check": "eslint . --max-warnings=0 && tsc --noEmit && tsc -p tsconfig.demo.json",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run check && npm test && npm run build",
    "verify:package": "npm run check && npm test && npm run build && node scripts/verify-package.mjs",
    "dev": "vite --config examples/standalone/vite.config.ts --host 127.0.0.1 --port 4185",
    "predev": "npm run build",
    "build:demo": "npm run build && vite build --config examples/standalone/vite.config.ts",
    "preview:demo": "vite preview --config examples/standalone/vite.config.ts --host 127.0.0.1 --port 4185"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.68.0"
  },
  "keywords": [
    "lyrics",
    "lrc",
    "waveform",
    "audio",
    "timeline",
    "lyrics-editor",
    "web-components",
    "custom-elements"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianyinshi/lyricue.git"
  },
  "homepage": "https://qianyinshi.github.io/lyricue/",
  "bugs": {
    "url": "https://github.com/qianyinshi/lyricue/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
